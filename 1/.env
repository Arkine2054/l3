# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433:5432
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=notifier
POSTGRES_URL=postgres://user:pass@postgres:5432/notifier?sslmode=disable

POSTGRES_MAX_OPEN_CONNS=7
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# API
API_PORT=8083:8083

# MailHog
MAILHOG_PORT1=1025:1025
MAILHOG_PORT2=8025:8025

# RabbitMq
RABBIT_PORT1=5672:5672
RABBIT_PORT2=15672:15672
RABBIT_URL=amqp://guest:guest@rabbitmq:5672/


# Redis
REDIS_ADDR=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

SMTP_ADDR=mailhog:1025
SMTP_FROM=no-reply@example.com
